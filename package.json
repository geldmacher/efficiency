{
  "name": "geldmacher-efficiency-plugin-development",
  "version": "3.3.0",
  "private": true,
  "description": "Development validation for the Geldmacher Efficiency Agent Plugins, Cursor, and Codex targets.",
  "files": [
    "plugin.json",
    ".codex-plugin",
    ".cursor-plugin",
    "adapters/codex",
    "agents",
    "assets",
    "CHANGELOG.md",
    "commands",
    "docs/agent-plugins-runtime-smoke.md",
    "docs/codex-runtime-smoke.md",
    "docs/installation.md",
    "docs/development.md",
    "docs/migrations.md",
    "docs/usage.md",
    "docs/receipts/2.0.0-code-simplicity.md",
    "docs/receipts/2.0.0.md",
    "docs/release-checklist.md",
    "docs/release-validation.md",
    "docs/runtime-smoke.md",
    "LICENSE",
    "README.md",
    "rules",
    "schemas/agent-plugins",
    "skills"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:targets": "node scripts/build-plugin-targets.mjs",
    "check:targets": "node scripts/build-plugin-targets.mjs --check",
    "deploy:prepare": "npm run build:targets && npm run check:targets && npm run validate && node --test tests/plugin-targets.test.mjs tests/local-plugin-deploy.test.mjs",
    "deploy:status": "node scripts/local-plugin-deploy.mjs status",
    "deploy:local": "node scripts/local-plugin-deploy.mjs deploy",
    "release:plugin": "node scripts/plugin-github-release.mjs",
    "validate": "node scripts/validate-plugin.mjs",
    "check:links": "node scripts/check-links.mjs",
    "test": "node --test",
    "release-check": "npm run check:targets && npm run validate && npm run check:links && npm test"
  },
  "devDependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "yaml": "^2.8.1"
  }
}
